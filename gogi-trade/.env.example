# Токен бота от @BotFather
BOT_TOKEN=
# API-ключ Gift Satellite (Профиль → Доступ к API)
SATELLITE_TOKEN=
# Публичный HTTPS-адрес мини-приложения, например https://gogi.example.com
# Пока пусто — бот работает, но кнопки мини-приложения нет (фильтры командами /add, /remove)
WEBAPP_URL=
# Порт HTTP-сервера мини-приложения
PORT=8080
# Telegram ID владельца. Если пусто — владельцем станет первый, кто нажмёт /start
OWNER_ID=
# Листинг считается новым, если он создан не раньше чем N секунд назад
FRESH_WINDOW_SEC=600
# Папка для данных (настройки, кэш каталога)
DATA_DIR=./data

# Только для docker compose: домен, на котором Caddy поднимет HTTPS.
# Без своего домена подойдёт адрес вида 203-0-113-10.sslip.io (IP сервера через дефисы).
# WEBAPP_URL должен быть https://<этот домен>
DOMAIN=
